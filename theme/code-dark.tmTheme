<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Syntax colours for code blocks on the dark Orion slides. -->
<plist version="1.0">
<dict>
  <key>name</key><string>Orion Dark</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#EDEDED</string>
      </dict>
    </dict>
    <dict>
      <key>scope</key><string>comment</string>
      <key>settings</key><dict><key>foreground</key><string>#8A8A8A</string><key>fontStyle</key><string>italic</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>keyword, storage, keyword.operator.word</string>
      <key>settings</key><dict><key>foreground</key><string>#F1C232</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>string, markup.raw</string>
      <key>settings</key><dict><key>foreground</key><string>#9FD08A</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>constant, constant.numeric, constant.language</string>
      <key>settings</key><dict><key>foreground</key><string>#F29E6D</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>entity.name.function, support.function, variable.function</string>
      <key>settings</key><dict><key>foreground</key><string>#7CC4E8</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class, storage.type</string>
      <key>settings</key><dict><key>foreground</key><string>#C9A6F0</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>entity.name.tag, entity.other.attribute-name, punctuation.definition.tag</string>
      <key>settings</key><dict><key>foreground</key><string>#7CC4E8</string></dict>
    </dict>
  </array>
</dict>
</plist>
